<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- Parent -->
	<style name="Widget.MyOnboarding.Parent" parent="">
		<item name="android:background">@drawable/onboarding_background</item>
		<item name="android:paddingTop">@dimen/large</item>
		<item name="android:paddingBottom">@dimen/large</item>
	</style>

	<!-- Page parent -->
	<style name="Widget.MyOnboarding.Page.Parent" parent="">
		<item name="android:paddingStart">@dimen/large</item>
		<item name="android:paddingEnd">@dimen/large</item>
	</style>

	<!-- Main title -->
	<style name="Widget.MyOnboarding.Main.Title" parent="">
		<item name="android:paddingTop">@dimen/normal</item>
		<item name="android:paddingBottom">@dimen/normal</item>
		<item name="android:gravity">center_horizontal</item>
		<item name="android:textColor">@color/white</item>
		<item name="android:textSize">@dimen/tsz_huge</item>
		<item name="android:textStyle">bold</item>
	</style>

	<!-- Main description -->
	<style name="Widget.MyOnboarding.Main.Description" parent="">
		<item name="android:paddingStart">@dimen/normal</item>
		<item name="android:paddingEnd">@dimen/normal</item>
		<item name="android:gravity">center_horizontal</item>
		<item name="android:textColor">@color/white_dull</item>
		<item name="android:textSize">@dimen/tsz_normal</item>
	</style>

	<!-- Section title -->
	<style name="Widget.MyOnboarding.Section.Title" parent="">
		<item name="android:layout_marginTop">@dimen/xxlarge</item>
		<item name="android:textColor">@color/white</item>
		<item name="android:textSize">@dimen/tsz_medium</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="Widget.MyOnboarding.Section.FirstTitle" parent="Widget.MyOnboarding.Section.Title">
		<item name="android:layout_marginTop">@dimen/huge</item>
	</style>

	<!-- Section description -->
	<style name="Widget.MyOnboarding.Section.Description" parent="">
		<item name="android:layout_marginTop">@dimen/twoline</item>
		<item name="android:layout_marginEnd">@dimen/small</item>
		<item name="android:textColor">@color/white_dull</item>
		<item name="android:textSize">@dimen/tsz_small</item>
	</style>

	<!-- Get started button -->
	<style name="Widget.MyOnboarding.Welcome.Button" parent="">
		<item name="android:layout_marginTop">@dimen/large</item>
		<item name="android:layout_marginBottom">@dimen/large</item>
		<item name="android:paddingStart">@dimen/xlarge</item>
		<item name="android:paddingEnd">@dimen/xlarge</item>
		<item name="android:textAllCaps">true</item>
		<item name="android:textColor">@color/black</item>
		<item name="android:textSize">@dimen/tsz_small</item>
		<item name="backgroundTint">@color/orange</item>
	</style>

	<!-- Allow button -->
	<style name="Widget.MyOnboarding.Permission.Button.Allow" parent="">
		<item name="android:layout_marginStart">@dimen/normal</item>
		<item name="android:layout_marginEnd">@dimen/zero</item>
		<item name="android:textColor">@color/black</item>
		<item name="android:textSize">@dimen/tsz_small</item>
		<item name="android:text">@string/word_allow</item>
		<item name="backgroundTint">@color/orange</item>
	</style>

	<!-- Navigation (next/back) button -->
	<style name="Widget.MyOnboarding.Navigation.Button" parent="@style/Widget.Material3.Button.TextButton">
		<item name="android:textColor">@color/orange</item>
		<item name="android:textSize">@dimen/tsz_normal</item>
		<item name="android:text">@string/word_allow</item>
	</style>

</resources>