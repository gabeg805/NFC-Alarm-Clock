	<!-- Descriptions -->
	<string name="description_onboarding_welcome">Witamy w najbardziej konfigurowalnej aplikacji budzika, jakiej kiedykolwiek używałeś</string>
	<string name="description_onboarding_permissions">Aby aplikacja działała prawidłowo, potrzebne są pewne uprawnienia</string>
	<string name="description_onboarding_permission_post_notifications_request">Wymagane do uruchomienia alarmów. Pozwala aplikacji na uruchomienie się i kontynuowanie działania, gdy nie jest jeszcze aktywna.</string>
	<string name="description_onboarding_permission_system_alert_window_request">To specjalne uprawnienie. Służy do zapewnienia wyświetlania ekranu alarmu i odtwarzania dźwięku. Wymagane tylko w systemie Android 15 lub w przypadku problemów specyficznych dla danego urządzenia, które uniemożliwiają uruchomienie alarmów.</string>
	<string name="description_onboarding_how_to_use_features">Niektóre rzeczy mogą być ukryte lub mylące. Oto jak to zrobić</string>
	<string name="description_onboarding_how_to_copy_and_delete">Przesuń alarm lub timer w prawo, aby skopiować, lub w lewo, aby usunąć.</string>
	<string name="description_onboarding_how_to_get_more_options">Naciśnij i przytrzymaj niemal dowolny przycisk w rozszerzonym alarmie/timerze, aby uzyskać dostęp do większej liczby opcji. Możesz nawet wypróbować tę funkcję na karcie alarmu, aby uzyskać opcje takie jak „Pomiń następny alarm” i inne.</string>
	<string name="description_onboarding_how_to_change_appearance">Przejdź do Ustawienia > Wygląd, aby znaleźć wszystkie opcje personalizacji i dostosować wygląd aplikacji do swoich potrzeb.</string>
	<string name="description_slide_to_snooze">Przesuń, aby drzemać</string>
	<string name="description_slide_to_dismiss">Przesuń, aby zamknąć</string>
	<string name="description_alarm_activity">Zeskanuj znacznik NFC, aby wyłączyć alarm.</string>
	<string name="description_no_notification">Nie pokazuj powiadomień.</string>
	<string name="description_upcoming_reminder">Przypomnienie o nadchodzących alarmach, które mają być aktywne.</string>
	<string name="description_active_alarm">Alarmy, które są aktualnie aktywne.</string>
	<string name="description_active_timer">Aktualnie aktywne liczniki czasu.</string>
