	<!-- Messages -->
	<string name="message_permission_ignore_battery_optimization_request">Zezwól na uruchomienie alarmu, jeśli aplikacja nie była używana przez pewien czas.&lt;br/>&lt;br/>&lt;b>Uwaga:&lt;/b> Zależy to od posiadanego urządzenia i &lt;b>może nie być konieczne&lt;/b>.</string>
	<string name="message_permission_post_notifications_request">Zezwól na uruchamianie alarmów, nawet gdy aplikacja nie jest w centrum uwagi.&lt;br/>&lt;br/>&lt;b>Uwaga:&lt;/b> jest to efekt uboczny zasad bezpieczeństwa wprowadzonych w &lt;b>Androidzie 13&lt;/b>, które mają na celu korzyści dla użytkowników, ale w takich przypadkach mogą ograniczać działanie aplikacji.</string>
