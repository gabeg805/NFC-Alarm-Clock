<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	style="@style/Widget.MyOnboarding.Page.Parent"
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Title -->
	<TextView
		style="@style/Widget.MyOnboarding.Main.Title"
		android:id="@+id/onboarding_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/title_how_to_use_features"
		app:layout_constraintTop_toTopOf="parent"
		/>

	<!-- Description -->
	<TextView
		style="@style/Widget.MyOnboarding.Main.Description"
		android:id="@+id/onboarding_description"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/description_onboarding_how_to_use_features"
		app:layout_constraintTop_toBottomOf="@id/onboarding_title"
		/>

	<!-- Scroll view -->
	<ScrollView
		android:id="@+id/onboarding_scrollview"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/onboarding_description"
		app:layout_constraintBottom_toBottomOf="parent">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<!-- Swipe to copy title -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.FirstTitle"
				android:id="@+id/onboarding_swipe_to_copy_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/title_how_to_copy"
				app:layout_constraintTop_toTopOf="parent"
				/>

			<!-- Swipe to copy description -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Description"
				android:id="@+id/onboarding_swipe_to_copy_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/description_onboarding_how_to_copy"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_copy_title"
				/>

			<!-- Swipe to copy image -->
			<!--
			<ImageView
				android:id="@+id/onboarding_swipe_to_copy_image"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/normal"
				android:src="@mipmap/swipe_to_copy"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_copy_description"
				/>
				-->

			<!-- Swipe to delete title -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Title"
				android:id="@+id/onboarding_swipe_to_delete_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/title_how_to_delete"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_copy_description"
				/>

			<!-- Swipe to delete description -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Description"
				android:id="@+id/onboarding_swipe_to_delete_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/description_onboarding_how_to_delete"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_delete_title"
				/>

			<!-- Swipe to delete image -->
			<!--
			<ImageView
				android:id="@+id/onboarding_swipe_to_delete_image"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/normal"
				android:src="@mipmap/swipe_to_delete"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_delete_description"
				/>
				-->

			<!-- Long press title -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Title"
				android:id="@+id/onboarding_long_press_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/title_how_to_get_more_options"
				app:layout_constraintTop_toBottomOf="@id/onboarding_swipe_to_delete_description"
				/>

			<!-- Long press description -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Description"
				android:id="@+id/onboarding_long_press_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/description_onboarding_how_to_get_more_options"
				app:layout_constraintTop_toBottomOf="@id/onboarding_long_press_title"
				/>

			<!-- Settings appearance title -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Title"
				android:id="@+id/onboarding_settings_appearance_title"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/title_how_to_change_appearance"
				app:layout_constraintTop_toBottomOf="@id/onboarding_long_press_description"
				/>

			<!-- Settings appearance description -->
			<TextView
				style="@style/Widget.MyOnboarding.Section.Description"
				android:id="@+id/onboarding_settings_appearance_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/description_onboarding_how_to_change_appearance"
				app:layout_constraintTop_toBottomOf="@id/onboarding_settings_appearance_title"
				/>
		</androidx.constraintlayout.widget.ConstraintLayout>
	</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>