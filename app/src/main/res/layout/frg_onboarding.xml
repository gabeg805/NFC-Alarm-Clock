<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	style="@style/Widget.MyOnboarding.Parent"
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- View pager -->
	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/onboarding_viewpager"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/onboarding_tab_layout_indicator"
		/>

	<!-- The Dots Indicator Container -->
	<com.google.android.material.tabs.TabLayout
		android:id="@+id/onboarding_tab_layout_indicator"
		android:layout_width="48dp"
		android:layout_height="16dp"
		android:layout_marginBottom="16dp"
		android:background="@android:color/transparent"
		app:tabBackground="@drawable/onboarding_tab_indicator"
		app:tabGravity="center"
		app:tabIndicatorHeight="0dp"
		app:tabMinWidth="0dp"
		app:tabMaxWidth="0dp"
		app:tabRippleColor="@android:color/transparent"
		app:layout_constraintBottom_toTopOf="@id/onboarding_next_button"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		/>

	<!-- Next/finish button -->
	<com.google.android.material.button.MaterialButton
		style="@style/Widget.MyOnboarding.Navigation.Button"
		android:id="@+id/onboarding_next_button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/word_next"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		/>

	<!-- Back button -->
	<com.google.android.material.button.MaterialButton
		style="@style/Widget.MyOnboarding.Navigation.Button"
		android:id="@+id/onboarding_back_button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/word_back"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		/>
</androidx.constraintlayout.widget.ConstraintLayout>